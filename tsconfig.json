{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "work/**",
    "supabase/functions/**",
    "node_modules_old/**",
    "admin-dashboard/**",
    "artifacts/**",
    "sites/**",
    "sportpro-control/**"
  ]
}
